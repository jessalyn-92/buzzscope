# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Any chat model that supports tool calling. Cheaper models work; check current names on platform.openai.com.
OPENAI_MODEL=gpt-5-mini

# Polite crawling defaults
PTT_DELAY_SEC=1.0
PTT_MAX_PAGES=20

# Salt for hashing PTT account ids before storage. Change it to your own random string.
BUZZSCOPE_SALT=change-me
AGENT_MAX_STEPS=24
